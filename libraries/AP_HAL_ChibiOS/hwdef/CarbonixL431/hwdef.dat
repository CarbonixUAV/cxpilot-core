# hw definition file for processing by chibios_pins.py
# Carbonix WING CPC board (schematic CX43040018)

# MCU class and specific type
MCU STM32L431 STM32L431xx

# bootloader starts firmware at 36k + 4k (STORAGE_FLASH)
FLASH_RESERVE_START_KB 40

# store parameters in pages 18 and 19
STORAGE_FLASH_PAGE 18
define HAL_STORAGE_SIZE 800

# board ID for firmware load
APJ_BOARD_ID 5000

# setup build for a peripheral firmware
env AP_PERIPH 1

# U10 is a 16MHz active crystal oscillator (VDD/EN/OUTPUT/GND), not a
# passive crystal, so HSE must run in bypass mode
OSCILLATOR_HZ 16000000
define STM32_HSE_BYPASS

# assume the 256k flash part
FLASH_SIZE_KB 256

define HAL_CAN_POOL_SIZE 6000

# no UARTs are broken out on this board; USART1 declared on free/unused
# pins purely to satisfy AP_HAL_ChibiOS's build requirements (UARTDriver.cpp
# references ChibiOS's SerialDriver type unconditionally) - not connected to
# any physical hardware on this board
SERIAL_ORDER USART1

PB6 USART1_TX USART1 SPEED_HIGH
PB7 USART1_RX USART1 SPEED_HIGH

# enable CAN support
PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1

# LED, status LED on PC13
PC13 LED OUTPUT LOW GPIO(1)

# pins for SWD debugging with a STlink or black-magic probe
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define HAL_USE_ADC TRUE
define STM32_ADC_USE_ADC1 TRUE

# rail-voltage sense ADC inputs (resistor-divider scaled, see schematic
# CX43040018 page 4 for R10/R16 (VIN), R11/R17 (8V2), R28/R32 (5V),
# R29/R33 (3V3) - divider ratios feed BATT_VOLT_MULT params, not hwdef)
PA0 8V2_ADC_IN ADC1 SCALE(1)
PA1 VIN_ADC_IN ADC1 SCALE(1)
PA2 5V_ADC_IN ADC1 SCALE(1)
PA3 3V3_ADC_IN ADC1 SCALE(1)

define HAL_NO_GPIO_IRQ
define SERIAL_BUFFERS_SIZE 512

define DMA_RESERVE_SIZE 2048

# stack for fast interrupts
define PORT_INT_REQUIRED_STACK 64

# MAIN_STACK is stack for ISR handlers
MAIN_STACK 0x300

# PROCESS_STACK controls stack for main thread
PROCESS_STACK 0xA00

define HAL_NO_GCS

define AP_PARAM_MAX_EMBEDDED_PARAM 512
