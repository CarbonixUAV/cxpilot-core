# hw definition file for processing by chibios_pins.py
# Carbonix WING CPC board (schematic CX43040018)

# MCU class and specific type
MCU STM32L431 STM32L431xx

# bootloader starts firmware at 36k + 4k (STORAGE_FLASH)
FLASH_RESERVE_START_KB 40

# store parameters in pages 18 and 19
STORAGE_FLASH_PAGE 18
define HAL_STORAGE_SIZE 800

# board ID for firmware load
APJ_BOARD_ID 5000

# setup build for a peripheral firmware
env AP_PERIPH 1

# U10 is a 16MHz active crystal oscillator (VDD/EN/OUTPUT/GND), not a
# passive crystal, so HSE must run in bypass mode
OSCILLATOR_HZ 16000000
define STM32_HSE_BYPASS

# assume the 256k flash part
FLASH_SIZE_KB 256

define HAL_CAN_POOL_SIZE 6000

# no UARTs are broken out on this board and HAL_NO_GCS is set below, so
# UART support is disabled entirely - see AP_HAL_ChibiOS/UARTDriver.cpp's
# HAL_NO_UARTDRIVER guard
SERIAL_ORDER
define HAL_USE_UART FALSE
define HAL_NO_UARTDRIVER TRUE

# enable CAN support
PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1

# LED, status LED on PC13
PC13 LED OUTPUT LOW GPIO(1)

# pins for SWD debugging with a STlink or black-magic probe
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# PGOOD monitoring for 5V, 8V2 and 3V3 regulated rails. VIN has no PGOOD
# net, it's the raw unregulated input.
PA8 5V_PGOOD  INPUT FLOATING GPIO(2)
PB9 8V2_PGOOD INPUT FLOATING GPIO(3)
PB6 3V3_PGOOD INPUT FLOATING GPIO(19)

# 5V/8V2 regulator enables. Driven HIGH by default so the rails are
# always enabled once the node is powered.
PB15 5V_PWR_EN  OUTPUT HIGH GPIO(14)
PB8  8V2_PWR_EN OUTPUT HIGH GPIO(15)

# I2C1 bus for the 4x on-board TMP1075 temperature sensors (addresses
# 0x48/0x4A/0x4B/0x4C)
PA9  I2C1_SCL I2C1
PA10 I2C1_SDA I2C1

define HAL_USE_I2C TRUE
define STM32_I2C_USE_I2C1 TRUE
I2C_ORDER I2C1

# 4x TMP1075 temperature sensors over DroneCAN. AP_TEMPERATURE_SENSOR_ENABLED
# must be forced on explicitly - it defaults to disabled below the 1024K
# flash threshold in AP_TemperatureSensor_config.h, and this board is 256K.
define AP_TEMPERATURE_SENSOR_ENABLED 1
define HAL_PERIPH_ENABLE_DEVICE_TEMPERATURE
define AP_TEMPERATURE_SENSOR_MAX_INSTANCES 4

# TMP1075 ALERT GPIOs
PA6  8V2_TEMP_ALERT INPUT FLOATING GPIO(4)
PB10 5V_TEMP_ALERT  INPUT FLOATING GPIO(5)
PB5  3V3_TEMP_ALERT INPUT FLOATING GPIO(6)
PB1  BRD_TEMP_ALERT INPUT FLOATING GPIO(7)

# LED strobe/position TPS27S100 high-side switch EN pins. Board has a
# pull-up to 3.3V on both EN nets (passive default = LED on) - firmware
# boot default set to match (HIGH = LED on).
PB2 LED_STROBE_EN   OUTPUT HIGH GPIO(8)
PA7 LED_POSITION_EN OUTPUT HIGH GPIO(9)

# LED strobe/position TPS27S100 FLT pins. DIAG_EN is tied to GND on both
# channels (not MCU-controlled), which per the TPS27S100 datasheet disables
# all diagnostics - FLT is permanently high-impedance and will never assert
# a fault unless the board is revised to drive DIAG_EN from the MCU.
PB0  LED_POSITION_FLT INPUT FLOATING GPIO(10)
PB12 LED_STROBE_FLT   INPUT FLOATING GPIO(11)

# LED fixture SYNC line and is GPS-epoch-phased pulse timing 
# in AP_Periph.cpp
PB11 LED_SYNC OUTPUT HIGH GPIO(16)

define HAL_USE_ADC TRUE
define STM32_ADC_USE_ADC1 TRUE

# rail-voltage sense ADC inputs (resistor-divider scaled, see schematic)
PA1 8V2_ADC_IN ADC1 SCALE(1)
PA2 VIN_ADC_IN ADC1 SCALE(1)
PA3 5V_ADC_IN ADC1 SCALE(1)
PA4 3V3_ADC_IN ADC1 SCALE(1)

# 4x rail-voltage monitors over DroneCAN (BatteryInfo), voltage-only
# (no current sensing on any of these rails).
#   BATT1 = VIN (pin 7, mult 10.9225)
#   BATT2 = 8V2 (pin 6, mult 3.9570)
#   BATT3 = 5V  (pin 8, mult 1.9829) - via defaults.parm, no hwdef default
#   BATT4 = 3V3 (pin 9, mult 1.5007) - via defaults.parm, no hwdef default
# BATT3/BATT4 have no HAL_BATT3_*/HAL_BATT4_* hwdef mechanism in AP_BattMonitor -
# see defaults.parm in this directory for their MONITOR/VOLT_PIN/VOLT_MULT params.
define HAL_PERIPH_ENABLE_BATTERY
define AP_BATT_MONITOR_MAX_INSTANCES 4

define HAL_BATT_MONITOR_DEFAULT 3
define HAL_BATT_VOLT_PIN 7
define HAL_BATT_VOLT_SCALE 10.9225
define HAL_BATT_CURR_PIN -1
define HAL_BATT_CURR_SCALE 0

define HAL_BATT2_MONITOR_DEFAULT 3
define HAL_BATT2_VOLT_PIN 6
define HAL_BATT2_VOLT_SCALE 3.9570
define HAL_BATT2_CURR_PIN -1
define HAL_BATT2_CURR_SCALE 0

define HAL_NO_GPIO_IRQ
define SERIAL_BUFFERS_SIZE 512

define DMA_RESERVE_SIZE 2048

# stack for fast interrupts
define PORT_INT_REQUIRED_STACK 64

# MAIN_STACK is stack for ISR handlers
MAIN_STACK 0x300

# PROCESS_STACK controls stack for main thread
PROCESS_STACK 0xA00

define HAL_NO_GCS

define AP_PARAM_MAX_EMBEDDED_PARAM 512
